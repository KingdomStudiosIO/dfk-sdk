{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@defikingdoms/game-sdk": [
        "./src/index.ts"
      ],
      "@defikingdoms/game-sdk/react": [
        "./src/react/index.tsx"
      ],
      "@defikingdoms/game-sdk/renderer": [
        "./src/renderer/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "examples"
  ]
}
