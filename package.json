{
  "name": "@defikingdoms/game-sdk",
  "version": "0.1.0",
  "description": "Build apps and games on DeFi Kingdoms: heroes, pets, equipment, items, balances, the marketplace, and write actions.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KingdomStudiosIO/dfk-sdk.git"
  },
  "homepage": "https://github.com/KingdomStudiosIO/dfk-sdk#readme",
  "bugs": {
    "url": "https://github.com/KingdomStudiosIO/dfk-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js",
      "require": "./dist/renderer/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "node scripts/demo.mjs --serve",
    "demo:build": "node scripts/demo.mjs",
    "sync": "node scripts/sync-from-interface.mjs",
    "sync:hero-generator": "node scripts/sync-hero-generator.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0"
  },
  "peerDependencies": {
    "ethers": "^5.7.0",
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.24.0",
    "ethers": "^5.8.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "defikingdoms",
    "dfk",
    "web3",
    "gamefi",
    "heroes",
    "nft",
    "sdk"
  ]
}
